        "python3",
        "tools/check_scaffold.py"
      ],
      "required_files": [
        "tools/check_scaffold.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "static-quality",
      "command": [
        "python3",
        "tools/static_quality.py"
      ],
      "required_files": [
        "tools/static_quality.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "repository-hygiene",
      "command": [
        "python3",
        "tools/check_repo_hygiene.py"
      ],
      "required_files": [
        "tools/check_repo_hygiene.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "check-artifacts",
      "command": [
        "python3",
        "tools/check_artifacts.py"
      ],
      "required_files": [
        "tools/check_artifacts.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "check-shared-fixtures",
      "command": [
        "python3",
        "tools/check_shared_fixtures.py"
      ],
      "required_files": [
        "tools/check_shared_fixtures.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "check-mirroring-audit",
      "command": [
        "python3",
        "tools/check_mirroring_audit.py"
      ],
      "required_files": [
        "tools/check_mirroring_audit.py",
        "docs/mirroring-coverage.json",
        "docs/mirroring-audit-evidence.json",
        "docs/mirroring-audit-original-evidence.json"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "python-tests",
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "required_files": [
        "tests"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "distributable-build",
      "not_applicable": "No distributable build command exists in this repository validation contract; this does not claim release acceptance."
    },
    {
      "id": "actual-upstream",
      "command": [
        "python3",
        "-B",
        "tools/check_upstream_ci.py"
      ],
      "required_files": [
        "tools/check_upstream_ci.py",
        "tools/check_upstream_sidecar.py",
        "upstream/pins.json",
        "upstream/requirements.txt"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "actual-upstream-optimized",
      "command": [
        "python3",
        "-B",
        "-O",
        "tools/check_upstream_ci.py"
      ],
      "required_files": [
        "tools/check_upstream_ci.py",
        "tools/check_upstream_sidecar.py",
        "upstream/pins.json",
        "upstream/requirements.txt"
      ],
      "timeout_seconds": 120
    }
  ],
  "lockfiles": [
    "requirements-quality.txt",
    "requirements-visual-linux-x64.lock",
    "tools/quality-baseline.json",
    "tools/quality-node/package-lock.json",
    "upstream/pins.json",
